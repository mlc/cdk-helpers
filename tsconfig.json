{
  "$schema": "https://json.schemastore.org/tsconfig",

  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/",
    "strict": true,
    "types": ["node"],
    "rewriteRelativeImportExtensions": true,
    "rootDir": "./src",
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
