{
  "$schema": "https://json.schemastore.org/tsconfig",

  "extends": "@tsconfig/node26/tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/",
    "strict": true,
    "types": ["node"],
    "rewriteRelativeImportExtensions": true,
    "rootDir": "./src",
    "sourceMap": true,
    "inlineSources": true,
    "declaration": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
