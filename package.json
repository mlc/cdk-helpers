{
  "name": "cdk-helpers",
  "packageManager": "yarn@4.18.0",
  "scripts": { "postinstall": "husky" },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0"
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  }
}
